// armed_trigger: Xcos block definition, PyQt6-mask pattern.
// Generated by casper_dsp/scripts/gen_sci_block.py -- review the port
// topology and TODOs below before relying on this in a real design.
function [x, y, typ] = armed_trigger(job, arg1, arg2)
    x=[];y=[];typ=[];
    select job
    case 'set' then
        x = arg1;
        export_exprs_to_tmpdir(x);
        bconfig = run_mask(x);
        x = update_exprs_from_tmpdir(x);
        x = armed_trigger_update_ports(x, bconfig);
    case 'define' then
        tag = 'armed_trigger';
        model = scicos_model();
        model.sim = list(tag, 4);
        model.blocktype = 'c';
        model.rpar = [];
        exprs = [];
        gr_i = [];
        model.in = [1, 2];
        model.in2 = [1, 1];
        model.out = [1];
        model.out2 = [1];
        // model.label doubles as the on-diagram display text (Scicos
        // aliases it with graphics.id); category is derived separately by
        // get_block_type.sci via file-probe, so this is free to be the name.
        model.label = tag;
        // icon size [5 4] scaled directly from armed_trigger's own
        // casper_library icon (50x38 px) -- see SKILL.md Step 3b
        x=standard_define([5 4],model,exprs,gr_i)
        x.graphics.in_label = ['arm', 'trig_in'];
        x.graphics.out_label = ['trig_out'];
        x.graphics.style = 'shape=rectangle;fillColor=#90EE90';
        /* init exprs */
        x = init_exprs(x);
        debug_info('armed_trigger block loaded...')
    end
endfunction

function [x] = armed_trigger_update_ports(obj, bconfigfn)
    // fixed port count: only widths/labels change, no set_io() needed
    // (same approach as swreg_update_ports)
    x = obj;
    bconfig = fromJSON(bconfigfn, 'file');
    p = bconfig('parameters');
    graphics = x.graphics;
    model = x.model;
    model.in = [1, 2];
    model.in2 = [1, 1];
    model.out = [1];
    model.out2 = [1];
    graphics.in_label = ['arm', 'trig_in'];
    graphics.out_label = ['trig_out'];
    graphics.style = 'shape=rectangle;fillColor=#90EE90';
    x.graphics = graphics;
    x.model = model;
endfunction
