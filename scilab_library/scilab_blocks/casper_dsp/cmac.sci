// cmac: Xcos block definition, PyQt6-mask pattern.
// Generated by gen_sci_block.py (fixed port topology), then hand-edited:
// port widths are computed from the mask parameters exactly as the HDL
// backend derives them, and the block name is shown below the fill color
// (same as pfb_fir_real.sci).
//
// Port layout = casper_library cmac (casper_library_correlator.slx, SID 810)
// port order: in a+bi, c+di, acc_in, sync, valid_in; out acc_out, valid_out.
// The two Simulink input names 'a+bi'/'c+di' are not legal Verilog
// identifiers (the Xcos port label becomes part of the generated top-level
// signal name, see collect_block_info.sci), so they are labelled 'a'/'b' --
// the port names of the HDL backend casper_dsp/rtl/Correlator/cmac.sv.
//
// Widths (cmac.sv):
//   bit_growth = ceil(log2(acc_len))
//   n_bits_out = n_bits_a + n_bits_b + 1 + bit_growth
//   a = {re, im}: 2*n_bits_a, b = {re, im}: 2*n_bits_b,
//   acc_in / acc_out = {re, im}: 2*n_bits_out, sync / valid_in / valid_out: 1
function [x, y, typ] = cmac(job, arg1, arg2)
    x=[];y=[];typ=[];
    select job
    case 'set' then
        x = arg1;
        export_exprs_to_tmpdir(x);
        bconfig = run_mask(x);
        x = update_exprs_from_tmpdir(x);
        x = cmac_update_ports(x, bconfig);
    case 'define' then
        tag = 'cmac';
        model = scicos_model();
        model.sim = list(tag, 4);
        model.blocktype = 'c';
        model.rpar = [];
        exprs = [];
        gr_i = [];
        // defaults of the JSON template: acc_len=128, n_bits_a=n_bits_b=4
        model.in = [1, 2, 3, 4, 5];
        model.in2 = cmac_in_widths(128, 4, 4);
        model.out = [1, 2];
        model.out2 = cmac_out_widths(128, 4, 4);
        // model.label doubles as the on-diagram display text (Scicos
        // aliases it with graphics.id); category is derived separately by
        // get_block_type.sci via file-probe, so this is free to be the name.
        model.label = tag;
        x=standard_define([10.8 13.2],model,exprs,gr_i)
        x.graphics.in_label = ['a', 'b', 'acc_in', 'sync', 'valid_in'];
        x.graphics.out_label = ['acc_out', 'valid_out'];
        /* init exprs */
        x = init_exprs(x);
        x.graphics.style = cmac_build_style(x.graphics.exprs(1));
        debug_info('cmac block loaded...')
    end
endfunction

// n_bits_out of cmac.sv: n_bits_a + n_bits_b + 1 + ceil(log2(acc_len))
function [w] = cmac_n_bits_out(acc_len, n_bits_a, n_bits_b)
    w = n_bits_a + n_bits_b + 1 + ceil(log2(acc_len));
endfunction

// a, b, acc_in, sync, valid_in
function [w] = cmac_in_widths(acc_len, n_bits_a, n_bits_b)
    n_bits_out = cmac_n_bits_out(acc_len, n_bits_a, n_bits_b);
    w = [2*n_bits_a, 2*n_bits_b, 2*n_bits_out, 1, 1];
endfunction

// acc_out, valid_out
function [w] = cmac_out_widths(acc_len, n_bits_a, n_bits_b)
    n_bits_out = cmac_n_bits_out(acc_len, n_bits_a, n_bits_b);
    w = [2*n_bits_out, 1];
endfunction

function [x] = cmac_update_ports(obj, bconfigfn)
    // fixed port count: only widths/labels change, no set_io() needed
    // (same approach as swreg_update_ports)
    x = obj;
    bconfig = fromJSON(bconfigfn, 'file');
    p = bconfig('parameters');
    graphics = x.graphics;
    model = x.model;
    acc_len = strtod(p('acc_len'));
    n_bits_a = strtod(p('n_bits_a'));
    n_bits_b = strtod(p('n_bits_b'));
    model.in = [1, 2, 3, 4, 5];
    model.in2 = cmac_in_widths(acc_len, n_bits_a, n_bits_b);
    model.out = [1, 2];
    model.out2 = cmac_out_widths(acc_len, n_bits_a, n_bits_b);
    graphics.in_label = ['a', 'b', 'acc_in', 'sync', 'valid_in'];
    graphics.out_label = ['acc_out', 'valid_out'];
    graphics.style = cmac_build_style(p('name'));
    x.graphics = graphics;
    x.model = model;
endfunction

/* build the graphics.style string for a given user-configurable block
   name, shown below the fill color (see displayedLabel). Strips ';' and
   '=' from the name since those are the mxGraph style string's own
   delimiter characters. */
function [style] = cmac_build_style(name)
    name = strsubst(string(name), ';', '');
    name = strsubst(name, '=', '');
    style = 'shape=rectangle;fillColor=#90EE90;strokeColor=black;fontColor=black;fontSize=12;align=center;verticalAlign=top;verticalLabelPosition=bottom;noLabel=0;displayedLabel=' + name + ';whiteSpace=wrap;html=1;spacing=4;';
endfunction
