// dual_pol_cmac: Xcos block definition, PyQt6-mask pattern.
// Generated by gen_sci_block.py (fixed port topology), then hand-edited:
// port widths are computed from the mask parameters exactly as the HDL
// backend derives them, and the block name is shown below the fill color
// (same as pfb_fir_real.sci).
//
// Port layout = casper_library dual_pol_cmac (casper_library_correlator.slx,
// SID 814) port names and order: in a1, a2, acc_in, sync, valid_in;
// out acc_out, valid_out. HDL backend: casper_dsp/rtl/Correlator/
// dual_pol_cmac.sv (same port names).
//
// Widths (dual_pol_cmac.sv):
//   n_bits_out = 2*n_bits_in + 1 + ceil(log2(acc_len))
//   a1 / a2 = {pol0 re, pol0 im, pol1 re, pol1 im}: 4*n_bits_in
//   acc_in / acc_out = {XX, YY, XY, YX}, each {re, im}: 8*n_bits_out
//   sync / valid_in / valid_out: 1
// bin_pt_in does not affect any width (it is not passed on by the mask).
function [x, y, typ] = dual_pol_cmac(job, arg1, arg2)
    x=[];y=[];typ=[];
    select job
    case 'set' then
        x = arg1;
        export_exprs_to_tmpdir(x);
        bconfig = run_mask(x);
        x = update_exprs_from_tmpdir(x);
        x = dual_pol_cmac_update_ports(x, bconfig);
    case 'define' then
        tag = 'dual_pol_cmac';
        model = scicos_model();
        model.sim = list(tag, 4);
        model.blocktype = 'c';
        model.rpar = [];
        exprs = [];
        gr_i = [];
        // defaults of the JSON template: acc_len=128, n_bits_in=4
        model.in = [1, 2, 3, 4, 5];
        model.in2 = dual_pol_cmac_in_widths(128, 4);
        model.out = [1, 2];
        model.out2 = dual_pol_cmac_out_widths(128, 4);
        // model.label doubles as the on-diagram display text (Scicos
        // aliases it with graphics.id); category is derived separately by
        // get_block_type.sci via file-probe, so this is free to be the name.
        model.label = tag;
        x=standard_define([8.4 8.4],model,exprs,gr_i)
        x.graphics.in_label = ['a1', 'a2', 'acc_in', 'sync', 'valid_in'];
        x.graphics.out_label = ['acc_out', 'valid_out'];
        /* init exprs */
        x = init_exprs(x);
        x.graphics.style = dual_pol_cmac_build_style(x.graphics.exprs(1));
        debug_info('dual_pol_cmac block loaded...')
    end
endfunction

// n_bits_out of dual_pol_cmac.sv: 2*n_bits_in + 1 + ceil(log2(acc_len))
function [w] = dual_pol_cmac_n_bits_out(acc_len, n_bits_in)
    w = 2*n_bits_in + 1 + ceil(log2(acc_len));
endfunction

// a1, a2, acc_in, sync, valid_in
function [w] = dual_pol_cmac_in_widths(acc_len, n_bits_in)
    n_bits_out = dual_pol_cmac_n_bits_out(acc_len, n_bits_in);
    w = [4*n_bits_in, 4*n_bits_in, 8*n_bits_out, 1, 1];
endfunction

// acc_out, valid_out
function [w] = dual_pol_cmac_out_widths(acc_len, n_bits_in)
    n_bits_out = dual_pol_cmac_n_bits_out(acc_len, n_bits_in);
    w = [8*n_bits_out, 1];
endfunction

function [x] = dual_pol_cmac_update_ports(obj, bconfigfn)
    // fixed port count: only widths/labels change, no set_io() needed
    // (same approach as swreg_update_ports)
    x = obj;
    bconfig = fromJSON(bconfigfn, 'file');
    p = bconfig('parameters');
    graphics = x.graphics;
    model = x.model;
    acc_len = strtod(p('acc_len'));
    n_bits_in = strtod(p('n_bits_in'));
    model.in = [1, 2, 3, 4, 5];
    model.in2 = dual_pol_cmac_in_widths(acc_len, n_bits_in);
    model.out = [1, 2];
    model.out2 = dual_pol_cmac_out_widths(acc_len, n_bits_in);
    graphics.in_label = ['a1', 'a2', 'acc_in', 'sync', 'valid_in'];
    graphics.out_label = ['acc_out', 'valid_out'];
    graphics.style = dual_pol_cmac_build_style(p('name'));
    x.graphics = graphics;
    x.model = model;
endfunction

/* build the graphics.style string for a given user-configurable block
   name, shown below the fill color (see displayedLabel). Strips ';' and
   '=' from the name since those are the mxGraph style string's own
   delimiter characters. */
function [style] = dual_pol_cmac_build_style(name)
    name = strsubst(string(name), ';', '');
    name = strsubst(name, '=', '');
    style = 'shape=rectangle;fillColor=#90EE90;strokeColor=black;fontColor=black;fontSize=12;align=center;verticalAlign=top;verticalLabelPosition=bottom;noLabel=0;displayedLabel=' + name + ';whiteSpace=wrap;html=1;spacing=4;';
endfunction
