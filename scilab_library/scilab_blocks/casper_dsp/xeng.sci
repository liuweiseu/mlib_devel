// xeng: Xcos block definition, PyQt6-mask pattern.
// Generated by gen_sci_block.py (fixed topology), then hand-edited for the
// computed port widths and the block-name style (same as pfb_fir_real.sci).
//
// Ports (fixed count; names/order = casper_library xeng_init.m, confirmed
// against casper_dsp/rtl/Correlator/xeng.sv's header):
//   in : sync_in (1), ant (4*n_bits), window_valid (1), mcnt_in (MCNT_BITS)
//   out: sync_out (1), acc (OW), valid (1), mcnt_out (MCNT_BITS)
// with (xeng.sv / xeng_descramble.sv):
//   W  = 2*n_bits + floor(log2(acc_len)) + 1   (= 2*N_BITS + $clog2(ACC_LEN+1))
//   OW = 8 * 2^ceil(log2(W)) / demux_factor
// MCNT_BITS is not a mask parameter (Simulink inherits it from the mcnt_in
// driver). The Scilab toolflow needs fixed port widths on both ends of a
// link (check_bit_width / gen_glue_module reject a mismatch), so mcnt_in and
// mcnt_out are fixed at 32 bits here, the RTL default; dsp_blocks/xeng.py
// reads the width actually linked to mcnt_in from jasper.json (falls back to
// 32) and passes it as MCNT_BITS.
//
// HDL backend: casper_dsp/rtl/Correlator/xeng.sv.
function [x, y, typ] = xeng(job, arg1, arg2)
    x=[];y=[];typ=[];
    select job
    case 'set' then
        x = arg1;
        export_exprs_to_tmpdir(x);
        bconfig = run_mask(x);
        x = update_exprs_from_tmpdir(x);
        x = xeng_update_ports(x, bconfig);
    case 'define' then
        tag = 'xeng';
        model = scicos_model();
        model.sim = list(tag, 4);
        model.blocktype = 'c';
        model.rpar = [];
        exprs = [];
        gr_i = [];
        // initial shape = the JSON template's defaults
        // (n_bits=4, acc_len=128, demux_factor=4)
        default_n_bits = 4;
        default_acc_len = 128;
        default_demux_factor = 4;
        mcnt_bits = xeng_mcnt_bits();
        model.in = [1, 2, 3, 4];
        model.in2 = [1, 4*default_n_bits, 1, mcnt_bits];
        model.out = [1, 2, 3, 4];
        model.out2 = [1, xeng_acc_width(default_n_bits, default_acc_len, default_demux_factor), 1, mcnt_bits];
        // model.label doubles as the on-diagram display text (Scicos
        // aliases it with graphics.id); category is derived separately by
        // get_block_type.sci via file-probe, so this is free to be the name.
        model.label = tag;
        x=standard_define([12 8.4],model,exprs,gr_i)
        x.graphics.in_label = ['sync_in', 'ant', 'window_valid', 'mcnt_in'];
        x.graphics.out_label = ['sync_out', 'acc', 'valid', 'mcnt_out'];
        /* init exprs */
        x = init_exprs(x);
        x.graphics.style = xeng_build_style(x.graphics.exprs(1));
        debug_info('xeng block loaded...')
    end
endfunction

// width of mcnt_in / mcnt_out (xeng.sv's MCNT_BITS default, see header)
function [w] = xeng_mcnt_bits()
    w = 32;
endfunction

// acc output width OW, exactly as xeng.sv derives it
function [ow] = xeng_acc_width(n_bits, acc_len, demux_factor)
    w = 2*n_bits + floor(log2(acc_len)) + 1;
    ow = 8 * 2^ceil(log2(w)) / demux_factor;
endfunction

function [x] = xeng_update_ports(obj, bconfigfn)
    // fixed port count: only widths/labels change, no set_io() needed
    // (same approach as swreg_update_ports)
    x = obj;
    bconfig = fromJSON(bconfigfn, 'file');
    p = bconfig('parameters');
    n_bits = strtod(p('n_bits'));
    acc_len = strtod(p('acc_len'));
    demux_factor = strtod(p('demux_factor'));
    mcnt_bits = xeng_mcnt_bits();
    graphics = x.graphics;
    model = x.model;
    model.in = [1, 2, 3, 4];
    model.in2 = [1, 4*n_bits, 1, mcnt_bits];
    model.out = [1, 2, 3, 4];
    model.out2 = [1, xeng_acc_width(n_bits, acc_len, demux_factor), 1, mcnt_bits];
    graphics.in_label = ['sync_in', 'ant', 'window_valid', 'mcnt_in'];
    graphics.out_label = ['sync_out', 'acc', 'valid', 'mcnt_out'];
    graphics.style = xeng_build_style(p('name'));
    x.graphics = graphics;
    x.model = model;
endfunction

/* build the graphics.style string for a given user-configurable block
   name, shown below the fill color (see displayedLabel). Strips ';' and
   '=' from the name since those are the mxGraph style string's own
   delimiter characters. */
function [style] = xeng_build_style(name)
    name = strsubst(string(name), ';', '');
    name = strsubst(name, '=', '');
    style = 'shape=rectangle;fillColor=#90EE90;strokeColor=black;fontColor=black;fontSize=12;align=center;verticalAlign=top;verticalLabelPosition=bottom;noLabel=0;displayedLabel=' + name + ';whiteSpace=wrap;html=1;spacing=4;';
endfunction
