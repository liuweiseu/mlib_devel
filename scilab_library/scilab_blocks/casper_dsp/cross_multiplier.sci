// cross_multiplier: Xcos block definition, PyQt6-mask pattern.
// Hand-written (not gen_sci_block.py) -- the output port count grows
// quadratically with the 'streams' mask parameter (1 + streams*(streams+1)/2),
// which the generator's linear factor_key "dynamic" topology can't express.
//
// Port layout mirrors casper_library/cross_multiplier_init.m:
//   in:  sync_in (port 1), din0 .. din<streams-1> (ports 2 .. streams+1),
//        each aggregation*2*bit_width_in bits
//   out: sync_out (port 1), then for x = 0..streams-1, y = x..streams-1:
//        din<x>_x_din<y> (port sum_{j<x}(streams-j) + (y-x) + 2),
//        each aggregation*2*bit_width_out bits
// Deviation: Simulink names the outputs 'din<x>_x_din<y>*' (the '*' marks
// the conjugate). The Xcos port label becomes part of a Verilog signal name
// (get_port_name.sci -> collect_block_info.sci -> glue modules / top-level
// nets), where '*' is not a legal identifier character, so it is dropped.
//
// HDL backend: casper_dsp/rtl/Correlator/cross_multiplier.sv, through the
// per-instance flat-port wrapper generated by dsp_blocks/cross_multiplier.py
// (the RTL's din/dout are packed 2-D arrays).
function [x, y, typ] = cross_multiplier(job, arg1, arg2)
    x=[];y=[];typ=[];
    select job
    case 'set' then
        x = arg1;
        export_exprs_to_tmpdir(x);
        bconfig = run_mask(x);
        x = update_exprs_from_tmpdir(x);
        x = cross_multiplier_update_ports(x, bconfig);
    case 'define' then
        tag = 'cross_multiplier';
        model = scicos_model();
        model.sim = list(tag,4);
        model.blocktype = 'c';
        model.rpar = [];
        exprs = [];
        gr_i = [];
        // initial on-canvas shape, before the user ever opens the mask --
        // matches the JSON template's own defaults (streams=2 -- the library
        // stores 0, an empty shell, see cross_multiplier.json --
        // aggregation=2, bit_width_in=4, bit_width_out=9)
        default_streams = 2;
        default_aggregation = 2;
        default_bit_width_in = 4;
        default_bit_width_out = 9;
        nout = default_streams*(default_streams+1)/2;
        [iports_index, iports_label] = cross_multiplier_create_iports(default_streams);
        model.in = iports_index;
        model.in2 = [1, default_aggregation*2*default_bit_width_in*ones(1, default_streams)];
        [oports_index, oports_label] = cross_multiplier_create_oports(default_streams);
        model.out = oports_index;
        model.out2 = [1, default_aggregation*2*default_bit_width_out*ones(1, nout)];
        model.label = tag;
        x=standard_define([9.6 39.6],model,exprs,gr_i)
        x.graphics.in_label = iports_label;
        x.graphics.out_label = oports_label;
        /* init exprs */
        x = init_exprs(x);
        x.graphics.style = cross_multiplier_build_style(x.graphics.exprs(1));
        debug_info('cross_multiplier loaded...')
    end
endfunction

// create input ports index and labels: sync_in, din0 .. din<streams-1>
function [ports_index, ports_label] = cross_multiplier_create_iports(streams)
    ports_label = ['sync_in'];
    ports_index = [1];
    port = 2;
    for i = 0:streams-1
        ports_label = [ports_label, 'din' + string(i)];
        ports_index = [ports_index, port];
        port = port + 1;
    end
endfunction

// create output ports index and labels: sync_out, then din<x>_x_din<y>
// for x = 0..streams-1, y = x..streams-1 (the order of the init's loops)
function [ports_index, ports_label] = cross_multiplier_create_oports(streams)
    ports_label = ['sync_out'];
    ports_index = [1];
    port = 2;
    for xi = 0:streams-1
        for yi = xi:streams-1
            ports_label = [ports_label, 'din' + string(xi) + '_x_din' + string(yi)];
            ports_index = [ports_index, port];
            port = port + 1;
        end
    end
endfunction

function [x]= cross_multiplier_update_ports(arg1, bconfigfn)
    x=arg1;
    bconfig = fromJSON(bconfigfn, 'file');
    graphics = arg1.graphics;
    exprs = graphics.exprs;
    model = arg1.model;
    params = bconfig('parameters');
    streams = strtod(params('streams'));
    aggregation = strtod(params('aggregation'));
    bit_width_in = strtod(params('bit_width_in'));
    bit_width_out = strtod(params('bit_width_out'));
    nout = streams*(streams+1)/2;
    evtin = [];
    evtout = [];
    [iports_index, iports_label] = cross_multiplier_create_iports(streams);
    [oports_index, oports_label] = cross_multiplier_create_oports(streams);
    io_in = [iports_index;iports_index];
    io_out = [oports_index;oports_index];
    io_in_type = ones(1, length(iports_index));
    io_out_type = ones(1, length(oports_index));
    [model,graphics,ok] = set_io(model, graphics, list(io_in', io_in_type), list(io_out', io_out_type), evtin, evtout);
    model.in = iports_index;
    // sync_in width 1, then one aggregation*2*bit_width_in bus per stream
    model.in2 = [1, aggregation*2*bit_width_in*ones(1, streams)];
    model.out = oports_index;
    // sync_out width 1, then one aggregation*2*bit_width_out bus per (x<=y) pair
    model.out2 = [1, aggregation*2*bit_width_out*ones(1, nout)];
    graphics.in_label = iports_label;
    graphics.out_label = oports_label;
    graphics.style = cross_multiplier_build_style(params('name'));
    graphics.exprs = exprs;
    x.graphics = graphics;
    x.model = model;
endfunction

/* build the graphics.style string for a given user-configurable block
   name, shown below the fill color (see displayedLabel). Strips ';' and
   '=' from the name since those are the mxGraph style string's own
   delimiter characters. */
function [style] = cross_multiplier_build_style(name)
    name = strsubst(string(name), ';', '');
    name = strsubst(name, '=', '');
    style = 'shape=rectangle;fillColor=#90EE90;strokeColor=black;fontColor=black;fontSize=12;align=center;verticalAlign=top;verticalLabelPosition=bottom;noLabel=0;displayedLabel=' + name + ';whiteSpace=wrap;html=1;spacing=4;';
endfunction
