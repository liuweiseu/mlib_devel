// ri_to_c: Xcos block definition, PyQt6-mask pattern.
// Generated by casper_dsp/scripts/gen_sci_block.py -- review the port
// topology and TODOs below before relying on this in a real design.
function [x, y, typ] = ri_to_c(job, arg1, arg2)
    x=[];y=[];typ=[];
    select job
    case 'set' then
        x = arg1;
        export_exprs_to_tmpdir(x);
        bconfig = run_mask(x);
        x = update_exprs_from_tmpdir(x);
        x = ri_to_c_update_ports(x, bconfig);
    case 'define' then
        tag = 'ri_to_c';
        model = scicos_model();
        model.sim = list(tag, 4);
        model.blocktype = 'c';
        model.rpar = [];
        exprs = [];
        gr_i = [];
        // 'z' packs real+imag components together (CASPER complex bus
        // convention), so its width is 2*n_bits, not n_bits.
        model.in = [1, 2];
        model.in2 = [18, 18];
        model.out = [1];
        model.out2 = [36];
        // model.label doubles as the on-diagram display text (Scicos
        // aliases it with graphics.id); category is derived separately by
        // get_block_type.sci via file-probe, so this is free to be the name.
        model.label = tag;
        x=standard_define([4 4],model,exprs,gr_i)
        x.graphics.in_label = ['re', 'im'];
        x.graphics.out_label = ['z'];
        x.graphics.style = 'shape=rectangle;fillColor=#90EE90';
        /* init exprs */
        x = init_exprs(x);
        debug_info('ri_to_c block loaded...')
    end
endfunction

function [x] = ri_to_c_update_ports(obj, bconfigfn)
    // fixed port count: only widths/labels change, no set_io() needed
    // (same approach as swreg_update_ports)
    x = obj;
    bconfig = fromJSON(bconfigfn, 'file');
    p = bconfig('parameters');
    graphics = x.graphics;
    model = x.model;
    n_bits = strtod(p('n_bits'));
    model.in = [1, 2];
    model.in2 = [n_bits, n_bits];
    model.out = [1];
    model.out2 = [2*n_bits];
    graphics.in_label = ['re', 'im'];
    graphics.out_label = ['z'];
    graphics.style = 'shape=rectangle;fillColor=#90EE90';
    x.graphics = graphics;
    x.model = model;
endfunction
