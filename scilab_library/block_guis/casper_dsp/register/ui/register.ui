       <widget class="QLineEdit" name="init"/>
   <widget class="QGroupBox" name="ports_box">
    <property name="title"><string>Optional Ports</string></property>
       <widget class="QCheckBox" name="rst">
     <property name="text"><string>Provide synchronous reset port</string></property>
    </widget>
